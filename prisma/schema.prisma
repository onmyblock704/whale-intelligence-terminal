// Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model WhaleTransaction {
  id          String   @id @default(cuid())
  hash        String   @unique
  from        String
  to          String?
  value       String
  blockNumber Int
  timestamp   DateTime @default(now())
}
